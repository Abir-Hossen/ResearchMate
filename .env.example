GROQ_API_KEY=your_Groq_API_key_here
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER=groq

# SSLCOMMERZ sandbox payment gateway (Phase 4.2+)
# Get test credentials from the SSLCOMMERZ sandbox merchant panel.
SSLCOMMERZ_STORE_ID=your_Sandbox_Store_ID_here
SSLCOMMERZ_STORE_PASSWORD=Your_Sandbox_Store_Password_here
SSLCOMMERZ_SANDBOX=True
SSLCOMMERZ_SUCCESS_URL=http://localhost:8000/subscriptions/payment/success/
SSLCOMMERZ_FAIL_URL=http://localhost:8000/subscriptions/payment/fail/
SSLCOMMERZ_CANCEL_URL=http://localhost:8000/subscriptions/payment/cancel/
